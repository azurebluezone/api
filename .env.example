# ==============================================================================
# ZombieCoder gateway - env-driven configuration template.
# Copy to .env and fill in the values marked <YOUR_*>.
# Never commit .env - it is gitignored. All secrets live there.
# ==============================================================================

# ─────────────── 1. Core Server ───────────────
# Main HTTP listen port (serves every endpoint)
PORT=5050
# Public URL of this instance (the cloud tunnel points here)
APP_URL=https://api.infiniteearningzone.com
# Host name used for identity and CORS
DOMAIN=localhost
# Display name / status
SERVER_NAME=Mission Barisal
SERVER_TYPE=development

# ─────────────── 2. Runtime Directories (all env-driven) ───────────────
DATA_DIR=./data
LOG_DIR=./logs
CACHE_DIR=./cache
CACHE_TTL=86400000
CACHE_MAX_ENTRIES=1000
SKILLS_DIR=./skills
SSOT_DIR=./.zombiecoder
LOCK_DIR=./locks
# SQLite models/agents DB (node:sqlite — zero-dependency)
DB_SQLITE_PATH=./data/models.db

# ─────────────── 3. Auth / Security (fail-closed) ───────────────
# Admin endpoint (responds 401 when no token is supplied)
ADMIN_TOKEN=<YOUR_ADMIN_TOKEN>
ADMIN_API_KEY=<YOUR_ADMIN_API_KEY>
ADMIN_USER=admin
MCP_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5010,http://localhost:5000,https://infiniteearningzone.com,https://*.infiniteearningzone.com
CORS_ORIGINS=http://localhost:5010,http://localhost:5000,https://infiniteearningzone.com,https://*.infiniteearningzone.com
# Agent file-system scope: unrestricted (default) | restricted -> sandbox
AGENT_FS_SCOPE=unrestricted
ALLOWED_DIRS=/home/sahon/z,/home/sahon/Desktop,/home/sahon/Documents,/home/sahon/Downloads
# Body-size guard — requests larger than this get 413 (bytes; default 10 MiB)
MAX_BODY_SIZE=10485760
# Rate limit and cooldown
MAX_RATE_LIMIT=50
RATE_LIMIT_COOLDOWN=10000
SESSION_TTL=86400000
# shell-exec (tool) limits
EXEC_TIMEOUT=60000
EXEC_MAX_BUFFER=10485760

# ─────────────── 4. PROVIDER — opencode ───────────────
OPENCODE_BASE=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=<YOUR_OPENCODE_API_KEY>
OPENCODE_PRIORITY=6
OPENCODE_MODELS=

# ─────────────── 5. PROVIDER — groq ───────────────
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_PRIORITY=2
GROQ_MODELS=

# ─────────────── 6. PROVIDER — gemini ───────────────
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_PRIORITY=3
GEMINI_MODELS=

# ─────────────── 7. PROVIDER — ollama (local) ───────────────
# Is `ollama serve` running on Linux? OLLAMA_BASE points at that server
OLLAMA_BASE=http://127.0.0.1:11435/v1
OLLAMA_API_KEY=
# ollama.com cloud (when a local server uses a cloud remote):
OLLAMA_CLOUD_API_KEY=<YOUR_OLLAMA_CLOUD_API_KEY>
OLLAMA_PRIORITY=1
OLLAMA_TYPE=openai
# DIALECT: "openai" = {OLLAMA_BASE}/chat/completions (bridge/LM Studio/vLLM)
OLLAMA_DIALECT=openai
# OLLAMA_SOCKET — UDS fast path for outbound provider traffic. provider/transport.js
OLLAMA_SOCKET=/tmp/local-llm.sock

# ─────────────── 8. PROVIDER — custom_N (generic) ───────────────
# (actually honoured since 2026-10-11)
CUSTOM_PROVIDER_1_ENABLED=false
CUSTOM_PROVIDER_1_NAME=
CUSTOM_PROVIDER_1_URL=
CUSTOM_PROVIDER_1_KEY=
CUSTOM_PROVIDER_1_PRIORITY=
CUSTOM_PROVIDER_1_TYPE=openai
CUSTOM_PROVIDER_1_MODELS=

# ─────────────── 9. Linux — UDS (MCP socket) ───────────────
UDS_PORT=5150
LOCAL_UDS_TIMEOUT=10000
# Shell used by shell-exec (Linux and Windows)
EXEC_SHELL_LINUX=/bin/bash
EXEC_SHELL_WIN=powershell.exe

# ─────────────── 10. Local LLM bridge (local-llm-bridge.js) ───────────────
# Safety: socket mode defaults to 600 (owner only). Use 660/777 if required
BRIDGE_SOCKET_MODE=600
# CORS: empty = loopback origins only; "*" = any; or a comma-separated list
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5050,http://127.0.0.1:5050
BRIDGE_PORT=11435
BRIDGE_SOCKET=/tmp/local-llm.sock
BRIDGE_INTERNAL_PORT=11437
# FIX (2026-10-19): was "qwen2.5:1.5b" — that model does NOT exist in the
BRIDGE_MODEL=qwen2.5-coder:1.5b
BRIDGE_UPSTREAM_MODEL=qwen2.5-coder:1.5b
BRIDGE_CTX=512
BRIDGE_THREADS=4
BRIDGE_OLLAMA_URL=http://127.0.0.1:11434

# ─────────────── 11. MCP server ports (external mcp/) ───────────────
# Port for each local MCP; leave empty to use the code-declared default
OCR_MCP_PORT=3110
SCREEN_MCP_PORT=3111
TTS_MCP_PORT=3112
COMBINED_MCP_PORT=3123
PUBLIC_API_MCP_PORT=3122
FB_ADS_MCP_PORT=3121
# Remote MCP servers (comma-separated "<name>:<url>")
EXTERNAL_MCP_URLS=
REMOTE_MCP_SERVERS=
MCP_CLIENTS_FILE=data/mcp-clients.json
MCP_READY_TIMEOUT_MS=30000

# ─────────────── 12. External Integrations ───────────────
# Pusher (real-time dashboard)
PUSHER_APP_ID=2175347
PUSHER_KEY=<YOUR_PUSHER_KEY>
PUSHER_SECRET=<YOUR_PUSHER_SECRET>
PUSHER_CLUSTER=ap2
# Facebook Ads MCP
FB_ACCESS_TOKEN=<YOUR_FB_ACCESS_TOKEN>
# PHP/Frontend (optional)
FRONTEND_PORT=8081
FRONTEND_URL=http://localhost:8081

# ─────────────── 13. Git content sync (optional) ───────────────
# Pull persona/skill/instruction files at startup (raw.githubusercontent URL)
GIT_PERSONAS_URL=https://raw.githubusercontent.com/ZombieCoder/personas/main/personas.md
GIT_SKILLS_URL=https://raw.githubusercontent.com/ZombieCoder/personas/main/skills.md
GIT_INSTRUCTIONS_URL=https://raw.githubusercontent.com/ZombieCoder/personas/main/instructions.md

# ─────────────── 14. Behaviour / Flags ───────────────
# Anti-dote (record mode) — prevents tool loops
ANTIDOTE_ENABLED=true
# Boundary validation (gates agent output)
BOUNDARY_VALIDATE=true
# Dev-model template (HAS_DEV_MODELS=true -> shows temporary dev models)
HAS_DEV_MODELS=true
# r2t (response-to-tool) virtual model
R2T_ENABLED=false
# Heartbeat / watchdog interval (ms)
WATCHDOG_INTERVAL=60000
# Debate / back-and-forth limit
MAX_DEBATE_ROUNDS=3
# Model aliases — "alias:realModel", comma-separated
MODEL_ALIASES=llama-local:qwen2.5-coder:1.5b,zombie-mini:qwen2.5-coder:1.5b

# ─────────────── 15. Branding (API / display) ───────────────
BRANDING_ORGANIZATION=ZombieCoder
BRANDING_TAGLINE=Mission Barisal
BRANDING_WEBSITE=https://infiniteearningzone.com
BRANDING_EMAIL=infi@infiniteearningzone.com

# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
BIND_HOST=127.0.0.1
brokerUrl=http://localhost:5000
sessionVerifyUrl=http://localhost:5050/api/verify-session
GROQ_TYPE=openai
SESSION_HMAC_REQUIRED=true
LOCAL_MAX_TOKENS=<YOUR_LOCAL_MAX_TOKENS>
CUSTOM_PROVIDER_3_ENABLED=true
CUSTOM_PROVIDER_3_NAME=Colab-GPU
CUSTOM_PROVIDER_3_URL=https://gpu.zombiecoder.my.id/v1
CUSTOM_PROVIDER_3_KEY=<YOUR_CUSTOM_PROVIDER_3_KEY>
CUSTOM_PROVIDER_3_PRIORITY=0
CUSTOM_PROVIDER_3_MODELS=
CUSTOM_PROVIDER_3_TYPE=openai
CUSTOM_PROVIDER_4_ENABLED=false
CUSTOM_PROVIDER_4_NAME=custom_4
CUSTOM_PROVIDER_4_URL=https://codecraftapi.com/v1
CUSTOM_PROVIDER_4_KEY=<YOUR_CUSTOM_PROVIDER_4_KEY>
CUSTOM_PROVIDER_4_PRIORITY=7
CUSTOM_PROVIDER_4_MODELS=
CUSTOM_PROVIDER_4_TYPE=openai
PROXY_LIST=
# CUSTOM_PROXY_API_KEY: not read anywhere in this codebase. Kept only as a
CUSTOM_PROXY_API_KEY=<YOUR_CUSTOM_PROXY_API_KEY>
MAX_TOOL_ROUNDS=15
# 2026-10-12: 20 -> 10. The Groq free tier allows only 8000 TPM; a 20-turn
MAX_HISTORY=10
SERVER_VERSION=3.2.1
DEPLOY_DOMAIN=api.infiniteearningzone.com
HAS_FRONTEND=true
HAS_PUSHER=true
# Serial run of 9 agents: 9 x ~246s ≈ 22 minutes
BRIDGE_TIMEOUT_MS=1200000
# 891MB model, 7.9GB free — 2 slots fit comfortably
OLLAMA_NUM_PARALLEL=2
# api.js:165 default is 500000 -> 8 agents hit a timeout at 500s
OLLAMA_TIMEOUT_MS=1200000
EDGE_TTS_PATH=/home/sahon/.local/bin/edge-tts
# Global agent-model escape hatch — consulted LAST by
AGENT_MODEL=

# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# A tool may run ONLY if its name was advertised in the request
TOOL_ALLOWLIST_STRICT=true
# Secret env vars (KEY/SECRET/PASSWORD/TOKEN/AUTH) read via env_get
SECRET_READ_POLICY=<YOUR_SECRET_READ_POLICY>
# Tools agents must NEVER receive, comma separated. Empty = no extra deny
AGENT_TOOL_POLICY=
# Tools the r2t (response-to-tool) engine may run. exec/git are OFF by
R2T_ALLOWED_TOOLS=info,list,read,stat

# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
# ── 1. OCR — image text extraction (ffmpeg + tesseract) ───────────────────
MCP_1_NAME=ocr
MCP_1_SCRIPT=external mcp/ocr-mcp.js
MCP_1_PORT=3110
MCP_1_PORT_ENV=OCR_MCP_PORT
MCP_1_PATH=/
MCP_1_ENABLED=true
MCP_1_DESC=OCR — image text extraction via tesseract
# ── 2. Screen recorder — screenshot + video (ffmpeg x11grab) ─────────────
MCP_2_NAME=screen-recorder
MCP_2_SCRIPT=external mcp/screen-recorder-mcp.js
MCP_2_PORT=3111
MCP_2_PORT_ENV=SCREEN_MCP_PORT
MCP_2_PATH=/
MCP_2_ENABLED=true
MCP_2_DESC=Screen recorder — screenshot + video recording via ffmpeg
# ── 3. TTS — text to speech (edge-tts) + playback ───────────────────────
MCP_3_NAME=tts
MCP_3_SCRIPT=external mcp/tts-mcp.js
MCP_3_PORT=3112
MCP_3_PORT_ENV=TTS_MCP_PORT
MCP_3_PATH=/
MCP_3_ENABLED=true
MCP_3_DESC=TTS — text to speech (Edge TTS) + playback via ffplay
# ── 4. Facebook Ads — 29 tools (needs FB_ACCESS_TOKEN in .env) ───────────
MCP_4_NAME=facebook-ads
MCP_4_SCRIPT=external mcp/facebook-ads-mcp.js
MCP_4_PORT=3121
MCP_4_PORT_ENV=FB_ADS_MCP_PORT
MCP_4_PATH=/mcp
MCP_4_ENABLED=true
MCP_4_DESC=Facebook Ads — 29 tools. Credentials: FB_ACCESS_TOKEN (env)
# ── 5. Public APIs — StackOverflow, weather, crypto, … (31 tools) ───────
MCP_5_NAME=public-api
MCP_5_SCRIPT=external mcp/public-api-mcp.js
MCP_5_PORT=3122
MCP_5_PORT_ENV=PUBLIC_API_MCP_PORT
MCP_5_PATH=/mcp
MCP_5_ENABLED=true
MCP_5_DESC=Public APIs (StackOverflow et al.) — 29 tools
# ── 6. Combined gateway — merges facebook-ads + public-api ──────────────
MCP_6_NAME=combined
MCP_6_SCRIPT=external mcp/combined.js
MCP_6_PORT=3123
MCP_6_PORT_ENV=COMBINED_MCP_PORT
MCP_6_PATH=/mcp
MCP_6_ENABLED=true
MCP_6_DESC=Gateway merging facebook-ads + public-api behind one port
# ── 7. Universal adapter — HTTP + HTTPS + stdio, pulls the main tools ───
MCP_7_NAME=universal-adapter
MCP_7_SCRIPT=universal-adapter/index.js
MCP_7_PORT=5400
MCP_7_PORT_ENV=ADAPTER_HTTP_PORT
MCP_7_PATH=/mcp
MCP_7_ENABLED=true
MCP_7_DESC=Universal transport adapter — serves its own tools plus the main server's
# ── OLLAMA CLOUD (ollama.com) ─────────────────────────────────────────
OLLAMA_CLOUD_BASE=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODELS=
OLLAMA_CLOUD_PRIORITY=998
OLLAMA_CLOUD_TIMEOUT_MS=120000
